# ─── Backend-Konfiguration ───────────────────────────────────────────────────
# Kopiere diese Datei als .env.development bzw. .env.production.
# Geladen wird .env.<NODE_ENV>; eine optionale .env ergänzt fehlende Werte.
# Bereits gesetzte Umgebungsvariablen (z.B. vom Hoster) haben immer Vorrang.

PORT=3001

# Pfad-Präfixe für API und Medien (Default: /api und /media)
API_PREFIX=/api
MEDIA_PREFIX=/media

# Maximale Größe eines Uploads in MB (Default: 500)
MAX_UPLOAD_MB=500

# Ablage für hochgeladene Medien, relativ zum Backend-Ordner (Default: storage)
STORAGE_DIR=storage

# CORS – erlaubte Frontend-Origin
ORIGIN_FE=http://localhost:5173

# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Secret zum Signieren der Login-Tokens (Pflicht für Admin-Login)
JWT_SECRET=
JWT_TTL=1h

# Admin-Routen nur mit gültigem Token erreichbar machen (in Produktion: true)
ADMIN_AUTH=false

# SQL-Queries loggen / max. DB-Verbindungen im Pool
DB_LOGGING=false
DB_POOL_MAX=10
